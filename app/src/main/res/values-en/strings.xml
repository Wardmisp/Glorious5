    <!-- Tutorial -->
    <string name="tutorial_skip">SKIP</string>
    <string name="tutorial_next">NEXT</string>
    <string name="tutorial_step1_title">Welcome!</string>
    <string name="tutorial_step1_body">Discover how to build your dream team in Glorious 5.</string>
    <string name="tutorial_step2_title">The Market</string>
    <string name="tutorial_step2_body">The goal is to recruit 5 players. But careful, your budget is capped at $50!</string>
    <string name="tutorial_step3_title">Let\'s Go</string>
    <string name="tutorial_step3_body">Let\'s start with a game against the computer.</string>
    <string name="tutorial_step4_title">The Player Card</string>
    <string name="tutorial_step4_body">Here\'s the player up for auction. Their stats are hidden at first and get revealed as bidding goes on.</string>
    <string name="tutorial_step5_title">The Timer</string>
    <string name="tutorial_step5_body">Each turn lasts 15 seconds. If no one bids before it runs out, the last bidder wins the player.</string>
    <string name="tutorial_step6_title">Bidding</string>
    <string name="tutorial_step6_body">Use these buttons to raise the bid. Be strategic so you don\'t burn through your budget too fast!</string>
    <string name="tutorial_step7_title">Passing</string>
    <string name="tutorial_step7_body">If the price is too high or the player doesn\'t interest you, you can pass.</string>
    <string name="tutorial_step8_title">Your Team</string>
    <string name="tutorial_step8_body">Check your roster and remaining budget at any time here.</string>
    <string name="tutorial_step9_title">Pre-Match Analysis</string>
    <string name="tutorial_step9_body">Once your team is built, the Scouting Report analyzes your chances of winning.</string>
    <string name="tutorial_step10_title">Win Probability</string>
    <string name="tutorial_step10_body">See your odds of success based on your roster\'s balance and talent.</string>
    <string name="tutorial_step11_title">Strengths &amp; Weaknesses</string>
    <string name="tutorial_step11_body">Compare the areas of play: Offense, Defense, Playmaking...</string>
    <string name="tutorial_step12_title">Key Matchups</string>
    <string name="tutorial_step12_body">See who dominates at each position. Bold names indicate a statistical edge.</string>
    <string name="tutorial_step13_title">Let\'s play!</string>
    <string name="tutorial_step13_body">You know it all! Good luck building the best possible team.</string>

